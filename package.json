{
  "name": "stockwise",
  "version": "1.0.0",
  "private": true,
  "description": "StockWise - Inventory and Stock Decision-Support System for a small electronics retailer",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/main.js",
    "dev": "npm run build && node dist/src/main.js",
    "seed": "npm run build && node dist/src/db/seed-cli.js",
    "test": "npm run build && node --test \"dist/tests/*.test.js\""
  },
  "devDependencies": {
    "@types/node": "^24.7.0",
    "typescript": "^5.9.3"
  }
}
